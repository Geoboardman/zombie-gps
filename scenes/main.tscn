[node name="RestOverlay" type="ColorRect" parent="HUD/RestControl"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 0
color = Color(0.02, 0.035, 0.045, 0.9)

[node name="Center" type="CenterContainer" parent="HUD/RestControl/RestOverlay"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="HUD/RestControl/RestOverlay/Center"]
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="HUD/RestControl/RestOverlay/Center/VBox"]
theme_override_font_sizes/font_size = 38
text = "CAMPING"
horizontal_alignment = 1

[node name="Message" type="Label" parent="HUD/RestControl/RestOverlay/Center/VBox"]
theme_override_font_sizes/font_size = 20
text = "Run paused.\nRest and continue when ready."
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="HUD/RestControl/RestOverlay/Center/VBox"]
custom_minimum_size = Vector2(240, 60)
theme_override_font_sizes/font_size = 22
text = "CONTINUE WALKING"

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-45, 30, 0)
